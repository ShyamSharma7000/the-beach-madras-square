# Public site URL, used for canonical links, sitemap and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Leave unset (or false) while this is a private preview: noindex, concept footer, sample content.
# Set to true only after docs/launch-checklist.md is complete and the venue has approved the site.
NEXT_PUBLIC_LAUNCHED=false

# Enquiry email delivery (server only, never exposed to the browser). Without both of the first
# two, the enquiry form is replaced by a "call the team" card, so nothing pretends to send.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Must be a sender on a domain verified in Resend. Default works only for testing.
ENQUIRY_FROM_EMAIL=
